# ─── Banco Protheus ───────────────────────────────────────────────────────────
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─── Segurança Flask ──────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# true em produção (HTTPS obrigatório); false em desenvolvimento local
SESSION_COOKIE_SECURE=false

# Duração da sessão em segundos (padrão: 28800 = 8h)
SESSION_LIFETIME_SECONDS=28800

# ─── Janela de resync por módulo ─────────────────────────────────────────────
# Cada variável controla quantos dias retroativos o sync horário reprocessa.
# Se a variável específica não for definida, usa SYNC_LOOKBACK_DAYS como fallback.
#
# SYNC_LOOKBACK_PEDIDOS     — Pedidos de Compra (compras + energy)
#   Pedidos podem ter aprovações lançadas semanas após emissão.
#   Valor seguro: 60 dias.
SYNC_LOOKBACK_PEDIDOS=60
#
# SYNC_LOOKBACK_HISTORICO   — Histórico de Pedidos
#   Relatório somente leitura, sem fluxo de aprovação.
#   Valor seguro: 30 dias.
SYNC_LOOKBACK_HISTORICO=30
#
# SYNC_LOOKBACK_NF          — NF de Entrada e NF de Saída (janela por emissão)
#   NFs são imutáveis após emissão; 30 dias captura entradas tardias.
#   Valor seguro: 30 dias.
SYNC_LOOKBACK_NF=30
#
# SYNC_LOOKBACK_MOV_BANCARIOS — Movimentos Bancários (janela por data movimento)
#   Movimentos raramente são alterados retroativamente.
#   Valor seguro: 30 dias.
SYNC_LOOKBACK_MOV_BANCARIOS=30
#
# SYNC_LOOKBACK_TITULOS     — Contas a Pagar, Contas a Receber, Energy Contas a Pagar
#   CRÍTICO: janela baseada em VENCIMENTO. Títulos em atraso têm vencimentos
#   antigos mas podem ser baixados meses depois. Um lookback curto faz o sync
#   ignorar essas baixas e deixar o saldo desatualizado no relatório.
#   Valor seguro: 365 dias.
SYNC_LOOKBACK_TITULOS=365
#
# SYNC_LOOKBACK_DAYS        — Fallback global (usado se a var específica não existir)
SYNC_LOOKBACK_DAYS=30

# ─── E-mail (Gmail) ───────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
