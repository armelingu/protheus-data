# ============================================================
# ProtheusData — Template de variaveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais
# NUNCA comite o arquivo .env
# ============================================================


# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------

# Chave secreta para sessoes e CSRF
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=


# ------------------------------------------------------------
# Banco de dados Protheus (SQL Server)
# ------------------------------------------------------------

DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=


# ------------------------------------------------------------
# E-mail — Microsoft Graph API
# ------------------------------------------------------------

EMAIL_ENABLED=true
EMAIL_PROVIDER=msgraph

# Endereco que aparece como remetente (deve ter permissao Mail.Send no Azure AD)
EMAIL_FROM=

# Registro de aplicativo no Microsoft Entra ID (Azure AD)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=


# ------------------------------------------------------------
# ETL — Agendamento
# ------------------------------------------------------------

# Hora do full refresh diario (0-23, horario local America/Sao_Paulo)
ETL_FULL_REFRESH_HORA=2

# Destinatarios dos alertas de full refresh (separados por virgula)
ETL_ALERT_EMAILS=


# ------------------------------------------------------------
# ETL — Timeouts e retries do Protheus
# ------------------------------------------------------------

PROTHEUS_CONNECT_TIMEOUT=30
PROTHEUS_QUERY_TIMEOUT=60
PROTHEUS_MAX_RETRIES=2


# ------------------------------------------------------------
# ETL — Janelas de sync incremental (dias)
# ------------------------------------------------------------

# Lookback padrao (usado como fallback se o especifico nao estiver definido)
SYNC_LOOKBACK_DAYS=30

# Lookback por modulo
SYNC_LOOKBACK_PEDIDOS=60
SYNC_LOOKBACK_NF=30
SYNC_LOOKBACK_TITULOS=365
SYNC_LOOKBACK_HISTORICO=30
SYNC_LOOKBACK_MOV_BANCARIOS=30
