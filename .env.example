# ─── Banco Protheus ───────────────────────────────────────────────────────────
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─── Segurança Flask ──────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# true em produção (HTTPS obrigatório); false em desenvolvimento local
SESSION_COOKIE_SECURE=false

# Duração da sessão em segundos (padrão: 28800 = 8h)
SESSION_LIFETIME_SECONDS=28800

# ─── E-mail (Gmail) ───────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
