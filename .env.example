# Banco de dados Protheus (SQL Server)
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Chave secreta Flask (gere uma string aleatória longa)
SECRET_KEY=

# E-mail (opcional — deixe EMAIL_ENABLED=false para desabilitar)
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# URL base da aplicação (usada nos e-mails enviados)
APP_BASE_URL=http://localhost:5000
